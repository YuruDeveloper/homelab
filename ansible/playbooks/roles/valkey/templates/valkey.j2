# Valkey Configuration File
# Generated by Ansible

# Network - 평문 포트는 닫고 TLS 전용으로 서비스한다
# (Debian 의 valkey 는 TLS 가 바이너리에 내장되어 있어 모듈 적재가 필요 없다)
bind 0.0.0.0
protected-mode no
port 0
tls-port {{ valkey_port }}

# TLS
tls-cert-file /etc/certificate/certificate.crt
tls-key-file /etc/certificate/certificate.key
tls-ca-cert-file /etc/ssl/certs/ca-certificates.crt
tls-auth-clients yes
tls-replication yes
tls-protocols "TLSv1.2 TLSv1.3"
tls-prefer-server-ciphers yes
tls-session-caching yes

# Security
requirepass {{ valkey_password }}
masterauth {{ valkey_password }}

# 0 = 비활성. 진실의 소스가 아니라 지킬 쓰기가 없는 반면, 2노드 구성에서 1 로 두면
# 레플리카 1대 다운만으로 쓰기가 전면 정지한다. 진실의 소스가 되면 재검토.
min-replicas-to-write 0
min-replicas-max-lag 10

# systemd 유닛의 PIDFile= 과 반드시 일치해야 한다
pidfile /run/valkey/valkey-server.pid

tcp-backlog 511
unixsocket /run/valkey/valkey.sock
unixsocketperm 770
timeout 0
tcp-keepalive 300
loglevel notice
logfile /var/log/valkey/valkey.log
databases 16
always-show-logo no
set-proc-title yes
proc-title-template "{title} {listen-addr} {server-mode}"
locale-collate ""
stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
rdb-del-sync-files no
dir /var/lib/valkey

replica-announce-ip {{ ansible_host }}

replica-serve-stale-data yes
replica-read-only yes
repl-diskless-sync yes
repl-diskless-sync-delay 5
repl-diskless-sync-max-replicas 0
repl-diskless-load disabled
repl-disable-tcp-nodelay no
replica-priority 100
acllog-max-len 128
lazyfree-lazy-eviction no
lazyfree-lazy-expire no
lazyfree-lazy-server-del no
replica-lazy-flush no
lazyfree-lazy-user-del no
lazyfree-lazy-user-flush no
oom-score-adj no
oom-score-adj-values 0 200 800
disable-thp yes
appendonly no
appendfilename "appendonly.aof"
appenddirname "appendonlydir"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb
aof-load-truncated yes
aof-use-rdb-preamble yes
aof-timestamp-enabled no

slowlog-log-slower-than 10000
slowlog-max-len 128
latency-monitor-threshold 0
notify-keyspace-events ""
hash-max-listpack-entries 512
hash-max-listpack-value 64
list-max-listpack-size -2
list-compress-depth 0
set-max-intset-entries 512
set-max-listpack-entries 128
set-max-listpack-value 64
zset-max-listpack-entries 128
zset-max-listpack-value 64
hll-sparse-max-bytes 3000
stream-node-max-bytes 4096
stream-node-max-entries 100
activerehashing yes
client-output-buffer-limit normal 0 0 0
client-output-buffer-limit replica 256mb 64mb 60
client-output-buffer-limit pubsub 32mb 8mb 60
hz 10
dynamic-hz yes
aof-rewrite-incremental-fsync yes
rdb-save-incremental-fsync yes
jemalloc-bg-thread yes
