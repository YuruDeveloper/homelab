{
        "root": "/etc/step-ca/certs/root_ca.crt",
        "federatedRoots": null,
        "crt": "/etc/step-ca/certs/intermediate_ca.crt",
        "key": "/etc/step-ca/secrets/intermediate_ca_key",
        "address": ":443",
        "insecureAddress": "",
        "dnsNames": [
                "192.168.2.6",
                "ca.home.arpa"
        ],
        "logger": {
                "format": "text"
        },
        "db": {
                "type": "badgerv2",
                "dataSource": "/etc/step-ca/db"
        },
        "authority": {
                "provisioners": [
                        {
                                "type": "JWK",
                                "name": "cecil",
                                "key": {
                                        "use": "sig",
                                        "kty": "EC",
                                        "kid": "{{ kid }}",
                                        "crv": "P-256",
                                        "alg": "ES256",
                                        "x": "{{ x }}",
                                        "y": "{{ y }}"
                                },
                                "encryptedKey": "{{ encryptedKey }}"
                        },
                        {
                                "type": "ACME",
                                "name": "lab-acme-server",
                                "claims": {
                                        "enableSSHCA": true,
                                        "disableRenewal": false,
                                        "allowRenewalAfterExpiry": false,
                                        "disableSmallstepExtensions": false
                                },
                                "options": {
                                        "x509": {
                                                "templateFile": "/etc/step-ca/templates/server.tpl"
                                        },
                                        "ssh": {}
                                }
                        },
                        {
                                "type": "ACME",
                                "name": "lab-acme-client",
                                "claims": {
                                        "enableSSHCA": true,
                                        "disableRenewal": false,
                                        "allowRenewalAfterExpiry": false,
                                        "disableSmallstepExtensions": false
                                },
                                "options": {
                                        "x509": {
                                                "templateFile": "/etc/step-ca/templates/client.tpl"
                                        },
                                        "ssh": {}
                                }
                        }
                ],
                "template": {},
                "backdate": "1m0s"
        },
        "tls": {
                "cipherSuites": [
                        "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
                        "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
                ],
                "minVersion": 1.2,
                "maxVersion": 1.3,
                "renegotiation": false
        },
        "commonName": "Step Online CA"
}