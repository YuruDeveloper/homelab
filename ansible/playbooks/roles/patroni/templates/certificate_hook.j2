#!/bin/sh
set -eu
# SIGHUP makes Patroni reload its config and the REST API TLS context.
if [ -f /run/patroni.pid ]; then
    kill -HUP "$(cat /run/patroni.pid)"
fi
# PostgreSQL only re-reads ssl_cert_file/ssl_key_file on reload.
su postgres -c "pg_ctl reload -D /var/lib/postgresql/{{ postgresql_version }}/data"
