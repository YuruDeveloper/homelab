# Valkey Sentinel Configuration File
# Generated by Ansible

# Network
protected-mode no
port 0
tls-port {{ sentinel_port }}

tls-cert-file /etc/certificate/certificate.crt
tls-key-file /etc/certificate/certificate.key
tls-ca-cert-file /etc/ssl/certs/ca-certificates.crt
tls-auth-clients yes
tls-replication yes
tls-protocols "TLSv1.2 TLSv1.3"

requirepass {{ valkey_password }}

daemonize no
pidfile /run/sentinel/valkey-sentinel.pid
loglevel notice
logfile /var/log/valkey/sentinel.log
dir /var/lib/valkey


SENTINEL resolve-hostnames yes
SENTINEL announce-hostnames yes

sentinel monitor {{ sentinel_prime_name }} {{ valkey_initial_prime_dns }} {{ valkey_port }} {{ sentinel_quorum }}
# 최초 관계 맺기. 레플리카를 미리 알려두면 Sentinel 이 role:master 를 자칭하는 노드에
# REPLICAOF 를 보내 복제를 성립시킨다. 심는 값은 노드의 replica-announce-ip 와 반드시
# 같은 문자열이어야 한다 — 동일성 키가 ip:port 라 표기가 다르면 한 노드가 두 번 등록된다.
{% for host in groups['valkey'] %}
{% if hostvars[host].ansible_host != valkey_initial_prime_dns %}
sentinel known-replica {{ sentinel_prime_name }} {{ hostvars[host].ansible_host }} {{ valkey_port }}
{% endif %}
{% endfor %}
sentinel auth-pass {{ sentinel_prime_name }} {{ valkey_password }}
sentinel down-after-milliseconds {{ sentinel_prime_name }} {{ sentinel_down_after_ms }}
sentinel parallel-syncs {{ sentinel_prime_name }} 1
sentinel failover-timeout {{ sentinel_prime_name }} 180000
sentinel deny-scripts-reconfig yes
acllog-max-len 128
SENTINEL master-reboot-down-after-period {{ sentinel_prime_name }} 0
