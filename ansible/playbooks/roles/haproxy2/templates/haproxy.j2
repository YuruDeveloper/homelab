#---------------------------------------------------------------------
# Global settings
#---------------------------------------------------------------------
global
    log         127.0.0.1 local2

    chroot      /var/lib/haproxy
    # pidfile 은 systemd 유닛이 -p 로 넘긴다. 여기서 또 지정하면 ALERT 가 난다.
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon

    # turn on stats unix socket
    stats socket /var/lib/haproxy/stats

#---------------------------------------------------------------------
# common defaults that all the 'listen' and 'backend' sections will
# use if not designated in their block
#---------------------------------------------------------------------
defaults
    mode                    tcp
    log                     global
    option                  tcplog
    option                  dontlognull
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          30s
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

#---------------------------------------------------------------------
# Frontend - Valkey Client Connections (TLS 종단)
#---------------------------------------------------------------------
frontend valkey-front
    bind *:{{ valkey_port }} ssl crt /etc/certificate/haproxy.pem
    mode tcp
    timeout client 1h
    default_backend valkey-prime

#---------------------------------------------------------------------
# Backend - Valkey Prime (Master) Auto-Detection
#---------------------------------------------------------------------
backend valkey-prime
    mode tcp
    option tcp-check
    timeout connect 5s
    timeout server 1h

    timeout check 1s

    balance first

    tcp-check connect ssl
    tcp-check send AUTH\ {{ valkey_password }}\r\n
    tcp-check expect string +OK
    tcp-check send PING\r\n
    tcp-check expect string +PONG
    tcp-check send QUIT\r\n
    tcp-check expect string +OK

    tcp-check connect port {{ sentinel_port }} ssl
    tcp-check send AUTH\ {{ valkey_password }}\r\n
    tcp-check expect string +OK
    tcp-check send SENTINEL\ get-master-addr-by-name\ {{ sentinel_prime_name }}\r\n
    tcp-check expect string-lf %[srv_name]

{% for host in groups['valkey'] %}
{% set node_dns = hostvars[host].ansible_host %}
    server {{ node_dns }} {{ node_dns }}:{{ valkey_port }} check inter 1s fall 3 rise 2 on-marked-down shutdown-sessions ssl verify required ca-file /etc/ssl/certs/ca-certificates.crt crt /etc/certificate/haproxy.pem sni str({{ node_dns }}) verifyhost {{ node_dns }}
{% endfor %}

#---------------------------------------------------------------------
# HAProxy Statistics and Prometheus Metrics
#---------------------------------------------------------------------
listen stats
    bind *:8404 ssl crt /etc/certificate/haproxy.pem
    mode http
    stats enable
    stats uri /
    stats refresh 10s
    stats show-legends
    stats show-desc Valkey HA Cluster (Prime Auto-Detection)
    http-request use-service prometheus-exporter if { path /metrics }
